{
	"appId": "com.adminai.app",
	"appName": "ADMIN AI",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"backgroundColor": "#0f172a"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"backgroundColor": "#0f172a",
			"showSpinner": false,
			"androidSpinnerStyle": "small",
			"splashFullScreen": true,
			"splashImmersive": true
		}
	}
}
